#!/bin/bash
#SBATCH --qos=<QOS>
#SBATCH --partition=<PARTITION>
#SBATCH --time=<WALL>
#SBATCH --job-name=<JOBNAME>
#SBATCH --account=<ACCOUNT>
#SBATCH --mem=<MEM>
#SBATCH --output=./out.out
#SBATCH --error=./out.err
<EMAILSECTION>

<OMPSECTION>

ulimit -s unlimited
#ulimit -c unlimited
#ulimit -s unlimited
#ulimit -d unlimited
#ulimit -m unlimited
ulimit -v unlimited
#ulimit -f unlimited
ulimit -a

# Run the job: the CPUs per task given to srun explicitly, since Slurm may raise SLURM_CPUS_PER_TASK above the
# requested --cpus-per-task (e.g. for --mem on a shared partition), and srun refuses to start when it differs
# from SLURM_TRES_PER_TASK
srun --cpus-per-task=${SLURM_CPUS_PER_TASK:-1} <CMD>
